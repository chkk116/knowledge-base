# 依赖服务环境变量（docker compose 用）
# 复制成 .env 后按需修改：cp .env.example .env

# ---------- Redis ----------
# 端口只绑 127.0.0.1，改这里只影响宿主机映射
REDIS_PORT=6379
# 宝塔的 Redis 默认没有密码；如果给它加了密码，这里填上（容器版也要同时打开 compose 里的 --requirepass）
REDIS_PASSWORD=

# ---------- Meilisearch（可选） ----------
MEILI_PORT=7700
# 必须 ≥16 字符，否则 Meilisearch 在 production 模式下拒绝启动
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# ---------- 后端连接参数（写进 /opt/kb/env.prod，不是给 compose 用的） ----------
# 走宝塔 Redis 时（推荐，无需 Docker）：
#   KB_REDIS_HOST=127.0.0.1
#   KB_REDIS_PORT=6379
#   KB_REDIS_PASSWORD=
# 走容器版时：同上（端口映射到 127.0.0.1 后对外一致）
#
# 接 Meilisearch 时：
#   KB_MEILI_URL=http://127.0.0.1:7700
#   KB_MEILI_KEY=<与 MEILI_MASTER_KEY 一致>
