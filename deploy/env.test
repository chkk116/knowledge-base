# ============================================================
# 测试环境变量【唯一需要修改的文件】
#
# 与生产同机不同端口 / 不同库 / 不同上传目录，来回切换不污染生产数据。
# 用法同 env.prod，只是 profile 换成 test。
# ============================================================

# ---- 域名（测试子域，用于 CORS 白名单）----
# 经 Nginx 同源反代时留空；前后端分离部署时填 https://test.example.com
KB_CORS_ORIGINS=
KB_CORS_ALLOW_CREDENTIALS=false

# ---- 后端端口（测试用 8081，与生产的 8080 隔离）----
KB_SERVER_PORT=8081

# ---- 数据库（测试库 kb_test，随便造数据）----
KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=kb_test
KB_DB_USER=kb
KB_DB_PASSWORD=kb
# 测试库允许自动建表，方便重置
KB_DDL_AUTO=update

# ---- 上传目录（与生产的 /var/www/kb/uploads 隔离）----
KB_UPLOAD_DIR=/var/www/kb-test/uploads

# ---- 协同编辑中继端口（测试用 1235）----
KB_COLLAB_PORT=1235

# ---- 密钥（测试可用占位值，建议也换成随机串）----
KB_TOKEN_SECRET=test-please-change-this-long-random-string
KB_ZHIPU_API_KEY=
