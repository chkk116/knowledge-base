# ============================================================
# 生产环境变量【唯一需要修改的文件】
#
# 换服务器 / 换域名 / 换密钥 / 换数据库 → 只改本文件，然后重启后端即可。
# 不需要改代码、不需要重新打包（mvn package 打出的 jar 通吃所有环境）。
#
# 用法：
#   set -a && source deploy/env.prod && set +a
#   java -jar backend/target/kbplatform.jar --spring.profiles.active=prod
# （或用 deploy/start-prod.sh，已封装好）
# ============================================================

# ---- 域名（换域名只改这里）----
# 前端访问域名，用于 CORS 白名单。多个用英文逗号分隔。
# 前后端经 Nginx 同源反代（/api 与前端同域）时留空即可，留空=不注册 CORS 规则，最安全。
KB_CORS_ORIGINS=
KB_CORS_ALLOW_CREDENTIALS=false

# ---- 后端端口（需与 deploy/nginx-example.conf 的 proxy_pass 一致）----
KB_SERVER_PORT=8080

# ---- 数据库（DB 跑在本机则保持 localhost，无需公网 IP）----
KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=kb
KB_DB_USER=kb
KB_DB_PASSWORD=kb
# 生产建议 validate：只校验表结构、不自动改表，避免 ddl-auto=update 意外变更生产表
KB_DDL_AUTO=validate

# ---- 上传目录【关键：必须绝对路径】----
# 相对路径会按「进程工作目录」解析，用 systemd 或换目录启动时会导致历史图片全部"找不到"。
# 数据库里存的是 /uploads/xxx.jpg 这样的相对 URL（不依赖域名），只要这个目录不变，换域名图片不会丢。
# 迁移服务器时：把旧机器的这个目录整体 rsync 到新机器相同路径即可。
KB_UPLOAD_DIR=/var/www/kb/uploads

# ---- 协同编辑中继端口（Nginx /collab/ 反代到此）----
KB_COLLAB_PORT=1234

# ---- 密钥（生产必填，务必换成随机长串）----
# 生成方式：openssl rand -hex 32
KB_TOKEN_SECRET=CHANGE_ME_请替换为32字节以上随机串
# AI 模型 Key 加密主密钥：必须注入且保持稳定，否则重启后已存的模型 Key 无法解密。
# 生成方式同上。AI 模型与 API Key 本身在「AI 模型管理」页填写，不走环境变量。
KB_AI_MASTER_KEY=CHANGE_ME_请替换为32字节以上随机串
