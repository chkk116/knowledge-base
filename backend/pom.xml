<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.kb</groupId>
    <artifactId>kb-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kb-platform</name>
    <description>Vue 3 + Spring Boot 4.1 知识库（本地 MySQL，搜索/检索优先，AI/RAG 预留）</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 本地 MySQL 8 数据库驱动（库连接串见 application.yml；业务表由 JPA 自动建）-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 富文本（文档正文 / 评论）XSS 净化：白名单过滤危险标签 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- 文档导入：Word(.docx) 解析为 HTML（含内嵌图片提取） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.0</version>
        </dependency>
        <!-- 文档导入：PDF 文本抽取 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- 文档导入：Markdown → HTML（含 GitHub 风格表格扩展） -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.24.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.24.0</version>
        </dependency>

        <!--
        ===== 可选增强（当前未纳入编译，docker 服务“后面再说”时再加）=====
        Meilisearch（中文分词/容错检索）与 MinIO（附件对象存储）为可选组件，
        本阶段仅用本地 MySQL 即可编译运行。启用方式见 README「可选增强：Meilisearch / MinIO」。
        -->

        <!--
        ===== AI / RAG 预留（当前未启用）=====
        为保证工程在 Maven Central 上稳定编译/运行，默认不含 Spring AI 依赖
        （Spring AI 2.0.0 仅有 -Mx 里程碑版，正式版需自行确认版本号）。
        待接入模型与向量库时：在 <dependencyManagement> 引入 spring-ai-bom（RELEASE 正式版），
        并添加 spring-ai-starter-model-ollama（或 openai）+ 向量库 starter，再替换 RagService / SearchService。
        详见 README「启用 AI 能力」。
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
