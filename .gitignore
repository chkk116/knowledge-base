# Maven
**/target/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Node / Vite
node_modules/
dist/
dist-v*/
dist-*/
.vite/
# npm 本地缓存（曾误提交进仓库，历史包袱；.gitignore 对已跟踪文件无效，需 git rm --cached）
.npmcache/

# 前端换色/构建备份（本地 tar.gz，非源码）
src-backup-*.tar.gz

# 运行时上传文件（头像/附件等，非源码，按环境生成）
backend/uploads/

# 运行时生成的缩略图缓存（按环境生成，可随时重建）
backend/thumbs/

# WorkBuddy 项目内部数据
.workbuddy/
.workbuddy-ai/

# OS
.DS_Store
Thumbs.db

# Windows 保留设备名误建出的文件（如 shell 重定向到 nul 产生，无法删除且非源码）
nul
*/nul

# 移动端（Capacitor）同步产物（由 sync-web.js 从 desktop/web 生成）
mobile/web-app/

# 本地日志
*.log

# 会话/token 缓存等序列化文件
*.pkl
logs/

# 本地密钥文件（含第三方 API Key，含敏感信息，绝不入库）
# application.yml 以 optional 方式导入本文件；缺失时 AI 走管理页配置的模型即可
backend/src/main/resources/application-secret.yml

# 仓库只收「帮助文档/截图」；内部 md 与安全审查报告一律不入库（仅本地留档，2026-10-19 用户明确）
docs/回归测试体系.md
docs/脑图连线自由拖拽-交接说明.md
docs/安全审查-*.md
安全审查报告-*.md
# 审查引擎原始结果（含完整发现细节，仅本地留档）
.ocr/

# Capacitor 本地配置备份（.bak 仅为本地临时回滚用）
mobile/capacitor.config.json.bak

# APK 签名密钥（含私钥，绝不入库；仅保留在本地/CI Secret）
mobile/android/keystore/
*.jks
*.keystore

# 前端构建产物打包（dist-vNNN.tar.gz，仅本地留存）
dist-v*.tar.gz

# APK/AAB 构建产物（体积大且含签名，仅本地/CI 留存）
outputs/apk/*.apk
outputs/apk/*.aab
outputs/*.pdf
outputs/*.png
outputs/kbtest.txt
outputs/test-*
outputs/ipmac-*

# 构建产物不入库（2026-10-09 仓库体积治理）
# 热更 bundle：构建产物，只留在本地/发布渠道
outputs/app-bundles/
# 大文件上传测试分片
parts/
# 后端 jar 构建产物
backend/**/*.jar
# 构建产物不入库（曾误提交 86MB 的 kb-platform-1.3.3.jar）
outputs/*.jar
# 发布脚本、发版数据与图标素材含部署信息，只留本地（.gitignore 不支持行尾注释，注释必须独立成行）
outputs/publish-*.sh
outputs/seed/
outputs/logo/
outputs/.deploykey
.deploykey

# 构建残留（maven 备份目录）
backend/.target_old_*/
outputs/.bundle-signing-key.pem
outputs/.bundle-signing-pub.pem
outputs/.bundle-signing-pub.b64
# filter-branch 临时目录
.git-rewrite/
